# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=earnhub
DB_USER=earnhub
DB_PASSWORD=your_db_password

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Business rules
REFERRAL_COMMISSION=30.00
WITHDRAWAL_THRESHOLD=100
ACTIVATION_AMOUNT=500.00
VIDEO_DEFAULT_REWARD=10.00

# PayHero — obtain from https://app.payhero.co.ke
PAYHERO_ENABLED=true
PAYHERO_API_BASE=https://backend.payhero.co.ke/api/v2
PAYHERO_STK_PATH=/payments/initiate-stk-push
PAYHERO_USERNAME=your_payhero_username
PAYHERO_PASSWORD=your_payhero_password
PAYHERO_CHANNEL_ID=your_registered_channel_id
PAYHERO_CALLBACK_URL=https://your-domain.com/api/payments/callback
