# Docker Compose reads this file for every application and database setting.
# Copy it to backend/.env before running Compose:
#   cp backend/.env.example backend/.env
# Keep backend/.env out of source control.

# Docker / MySQL
MYSQL_DATABASE=earnhub
MYSQL_USER=earnhub
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
FRONTEND_PORT=8080

# Backend database connection (DB_HOST and DB_PORT are overridden by Compose)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=earnhub
DB_USER=earnhub
DB_PASSWORD=replace-with-a-strong-database-password

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# CORS
CORS_ORIGINS=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=docker

# First-run admin. Required when the users table is empty.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_me_with_a_strong_unique_password
APP_TIMEZONE=Africa/Nairobi

# Business rules
REFERRAL_COMMISSION=30.00
WITHDRAWAL_THRESHOLD=100
ACTIVATION_AMOUNT=500.00
VIDEO_DEFAULT_REWARD=10.00

# PayHero — obtain from https://app.payhero.co.ke
PAYHERO_ENABLED=false
PAYHERO_API_BASE=https://backend.payhero.co.ke/api/v2
PAYHERO_STK_PATH=/payments
PAYHERO_USERNAME=your_payhero_username
PAYHERO_PASSWORD=your_payhero_password
PAYHERO_CHANNEL_ID=your_registered_channel_id
PAYHERO_CALLBACK_URL=https://your-domain.com/api/payments/payhero/callback

# Optional development-only seed (use with SPRING_PROFILES_ACTIVE=dev).
SEED_INITIAL_USERS=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_REFERRAL_EMAIL=
DEV_REFERRAL_PASSWORD=
DEV_REFERRAL_PHONE=
