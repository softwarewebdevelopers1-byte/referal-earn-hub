# Docker Compose application settings. Copy to .env and replace every
# replace_me value before starting the stack.

# MySQL (the named volume is referral-platform-mysql-data)
MYSQL_DATABASE=referralhub
MYSQL_USER=referal_app
MYSQL_PASSWORD=replace_me_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_me_with_a_strong_root_password

# Host bindings. MySQL is intentionally not published to the host.
FRONTEND_PORT=8080
BACKEND_PORT=8000
SERVER_PORT=8080

# Application security. Generate with: openssl rand -base64 64
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
CORS_ORIGINS=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080

# Business configuration
REFERRAL_COMMISSION=30.00
WITHDRAWAL_THRESHOLD=100
ACTIVATION_AMOUNT=5.00
VIDEO_DEFAULT_REWARD=10.00

# PayHero. Keep disabled for local Docker verification unless real credentials
# and a publicly reachable HTTPS callback URL are configured.
PAYHERO_ENABLED=false
PAYHERO_API_BASE=https://backend.payhero.co.ke/api/v2
PAYHERO_STK_PATH=/payments
PAYHERO_USERNAME=replace_me
PAYHERO_PASSWORD=replace_me
PAYHERO_CHANNEL_ID=replace_me
PAYHERO_CALLBACK_URL=https://your-public-domain.example/api/payments/payhero/callback

# Set SPRING_PROFILES_ACTIVE=dev only for the existing development seed.
# Never enable the dev seed with production credentials or production data.
SPRING_PROFILES_ACTIVE=docker
SEED_INITIAL_USERS=false
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace_me_with_a_development_password
DEV_REFERRAL_EMAIL=referrer@example.com
DEV_REFERRAL_PASSWORD=replace_me_with_a_development_password
DEV_REFERRAL_PHONE=+254700000001

# Leave empty for the Docker same-origin frontend proxy. The browser must not
# be configured with the internal hostname "backend".
VITE_API_BASE_URL=
